# Take Phone — переменные окружения
# Скопируйте в .env.local (файл уже в .gitignore) и заполните.
# Ни один секрет не должен попадать в репозиторий.

# ---------------------------------------------------------------- каталог

# fixtures — демонстрационный набор данных из репозитория (значение по умолчанию)
# live     — чтение согласованных прайс-листов поставщиков
CATALOG_MODE=fixtures

# Адреса прайс-листов. Нужны только при CATALOG_MODE=live.
# Ожидается JSON: массив предложений или { "items": [...] }.
# Формат одной позиции описан в lib/catalog/types.ts (RawOffer).
SOURCE_FIRST_APPLE_FEED_URL=
SOURCE_ICE_APPLE_FEED_URL=
SOURCE_PHONE24_FEED_URL=

# Токены, если поставщик закрывает прайс-лист авторизацией (Bearer).
SOURCE_FIRST_APPLE_TOKEN=
SOURCE_ICE_APPLE_TOKEN=
SOURCE_PHONE24_TOKEN=

# ------------------------------------------------------------- база данных

# Имя биндинга Cloudflare D1. По умолчанию DB — так объявлено в
# .openai/hosting.json ("d1": "DB"). Без биндинга приложение работает
# на хранилище в памяти процесса: это допустимо только локально.
D1_BINDING=DB

# ------------------------------------------------------- панель сотрудника

# ОБЯЗАТЕЛЬНО для рабочего стенда. Пока переменные не заданы:
#   локально (NODE_ENV != production) — демонстрационный пароль takephone;
#   в production — панель отдаёт ошибку конфигурации и не открывается.
# Пароль takephone запрещено использовать в production.
STAFF_PASSWORD=
STAFF_SESSION_SECRET=

# Разрешить демонстрационный пароль в production-сборке. Только для стенда,
# который вы сознательно помечаете как превью.
ALLOW_DEMO_STAFF_ACCESS=

# ---------------------------------------------------------------- расчёты

# Комиссия при оплате банковской картой. 0.135 = 13,5%.
# Значение нужно подтвердить с владельцем магазина (см. README).
# Серверные расчёты:
CARD_PAYMENT_FEE_RATE=0.135
# То же значение для интерфейса в браузере — задавайте вместе с предыдущим,
# иначе на экране и на сервере окажутся разные суммы.
NEXT_PUBLIC_CARD_PAYMENT_FEE_RATE=0.135

# ---------------------------------------------------------------- заявки

# Заявка всегда сохраняется в базе и видна в панели сотрудника.
# Переменные ниже добавляют внешний канал уведомлений. Если они не заданы,
# интерфейс честно пишет, что сообщение никуда не отправлялось.

# Вариант 1 — Telegram (приоритетный, если заданы оба значения).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Вариант 2 — произвольный webhook (CRM, amoCRM, Bitrix24, Make и т. п.).
ORDER_WEBHOOK_URL=
